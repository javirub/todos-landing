#!/usr/bin/env bash
# Milliseconds only. Whatever goes here is paid on every commit, so it holds the one
# check that is free and catches a mistake that is otherwise silent: a credential or a
# build artefact staged by accident. The types and the build wait for pre-push.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# `--amend --no-edit` with nothing staged, for one.
git diff --cached --quiet && exit 0

bad=0
while IFS= read -r file; do
  case "$file" in
    .env|.env.*|*.pem|*.key)
      echo "pre-commit: $file does not belong in this repository." >&2; bad=1 ;;
    dist/*|.astro/*)
      echo "pre-commit: $file is built, not written. It should not be committed." >&2; bad=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

exit "$bad"
