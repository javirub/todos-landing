---
import { Image } from 'astro:assets'
import { contentFor, INSTALL_COMMANDS, DOCS_URL, type Language } from '../i18n/content'
import { inlineCode } from '../i18n/format'

import overview from '../assets/overview.png'
import steps from '../assets/steps.png'
import identity from '../assets/identity.png'
import blocked from '../assets/blocked.png'
import statusline from '../assets/statusline.png'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = contentFor(language)

/* The shots are 2160px wide and never displayed above ~1150 CSS pixels, so two widths
   cover one-times and two-times displays and nothing larger is generated. */
const shotWidths = [760, 1150, 1720]
const shotSizes = '(min-width: 1024px) 1100px, calc(100vw - 2.5rem)'

---

{/* ------------------------------------------------------------------ the board */}
<section class="relative -mt-36 pb-20 sm:pb-24 lg:-mt-44">
  <div class="mx-auto max-w-6xl px-5">
    <figure class="will-reveal">
      <Image
        src={overview}
        alt={t.meta.ogAlt}
        widths={shotWidths}
        sizes={shotSizes}
        loading="eager"
        fetchpriority="high"
        class="w-full rounded-[var(--radius-token-lg)] border border-line shadow-[0_2px_4px_oklch(0_0_0/.04),0_24px_60px_-28px_oklch(0_0_0/.25)]"
      />
      <figcaption class="mt-4 text-center text-sm text-faint">{t.board.caption}</figcaption>
    </figure>

    <div class="mx-auto mt-16 max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">{t.board.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t.board.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{t.board.body}</p>
    </div>
  </div>
</section>

{/* ------------------------------------------------------------- how it gets there */}
<section id="how" class="scroll-mt-20 border-y border-line bg-bg py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">{t.recorded.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t.recorded.title}</h2>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {
        t.recorded.steps.map((step, i) => (
          <li class="card will-reveal p-6">
            <span
              class="flex size-8 items-center justify-center rounded-full bg-accent-soft font-mono text-sm font-semibold text-accent"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <figure class="will-reveal mt-12">
      <Image
        src={statusline}
        alt={
          language === 'en'
            ? 'A terminal status line counting the pending manual steps for the current project.'
            : 'Una línea de estado de terminal contando los pasos manuales pendientes del proyecto actual.'
        }
        widths={[588, 1177]}
        sizes="(min-width: 640px) 588px, calc(100vw - 2.5rem)"
        loading="lazy"
        class="w-full max-w-xl rounded-[var(--radius-token)] border border-line"
      />
    </figure>
  </div>
</section>

{/* ------------------------------------------------------- what a step carries */}
<section id="step" class="scroll-mt-20 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">{t.anatomy.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t.anatomy.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{t.anatomy.body}</p>
    </div>

    <div class="mt-12 grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
      <dl class="grid gap-5">
        {
          t.anatomy.items.map((item) => (
            <div class="will-reveal border-l-2 border-accent-soft pl-5">
              <dt class="font-semibold">{item.title}</dt>
              <dd class="mt-1.5 leading-relaxed text-muted" set:html={inlineCode(item.body)} />
            </div>
          ))
        }
      </dl>

      <figure class="will-reveal">
        <Image
          src={steps}
          alt={t.anatomy.caption}
          widths={shotWidths}
          sizes={shotSizes}
          loading="lazy"
          class="w-full rounded-[var(--radius-token-lg)] border border-line shadow-[0_2px_4px_oklch(0_0_0/.04),0_24px_60px_-28px_oklch(0_0_0/.25)]"
        />
        <figcaption class="mt-3 text-sm text-faint">{t.anatomy.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

{/* ----------------------------------------------------------------- projects */}
<section id="projects" class="scroll-mt-20 border-y border-line bg-bg py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">{t.identity.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t.identity.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{t.identity.body}</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <figure class="will-reveal">
        <Image
          src={identity}
          alt={t.identity.caption}
          widths={[560, 1120, 1720]}
          sizes="(min-width: 1024px) 540px, calc(100vw - 2.5rem)"
          loading="lazy"
          class="w-full rounded-[var(--radius-token-lg)] border border-line"
        />
        <figcaption class="mt-3 text-sm text-faint">{t.identity.caption}</figcaption>
      </figure>

      <figure class="will-reveal">
        <Image
          src={blocked}
          alt={t.anatomy.items[3]!.title}
          widths={[560, 1120, 1720]}
          sizes="(min-width: 1024px) 540px, calc(100vw - 2.5rem)"
          loading="lazy"
          class="w-full rounded-[var(--radius-token-lg)] border border-line"
        />
        <figcaption class="mt-3 text-sm text-faint">{t.anatomy.items[3]!.title}</figcaption>
      </figure>
    </div>
  </div>
</section>

{/* ------------------------------------------------------------------- modes */}
<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">{t.modes.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t.modes.title}</h2>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        [t.modes.local, t.modes.cloud].map((mode, i) => (
          <div
            class={
              i === 0
                ? 'card will-reveal border-accent/25 bg-accent-soft/40 p-7'
                : 'card will-reveal p-7'
            }
          >
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="text-xl font-semibold">{mode.title}</h3>
              <span
                class={
                  i === 0
                    ? 'rounded-full bg-success/12 px-2.5 py-0.5 text-xs font-semibold text-success'
                    : 'rounded-full border border-line-strong px-2.5 py-0.5 text-xs font-semibold text-faint'
                }
              >
                {mode.badge}
              </span>
            </div>

            <p class="mt-3 leading-relaxed text-muted">{mode.body}</p>

            <ul class="mt-5 grid gap-2.5 text-sm text-muted">
              {mode.points.map((point) => (
                <li class="flex gap-2.5">
                  <svg
                    class={i === 0 ? 'mt-1 size-4 shrink-0 text-success' : 'mt-1 size-4 shrink-0 text-faint'}
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="m3.5 8.5 3 3 6-7"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

{/* ----------------------------------------------------------------- install */}
<section id="install" class="scroll-mt-20 bg-night py-20 text-night-text sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-start">
      {/* `min-w-0` on both columns is load-bearing, not tidying. A grid item defaults to
          `min-width: auto`, so the non-wrapping command below stretched the track past
          the viewport and gave the whole page a sideways scrollbar on a phone. */}
      <div class="min-w-0">
        <p class="text-sm font-semibold uppercase tracking-widest text-violet-bright">
          {t.install.eyebrow}
        </p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t.install.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-night-muted" set:html={inlineCode(t.install.body, 'dark')} />

        <div class="mt-8 grid gap-3">
          {
            INSTALL_COMMANDS.map((command) => (
              <div class="flex min-w-0 items-center gap-3 rounded-[var(--radius-token)] border border-white/12 bg-black/30 py-2 pl-4 pr-2">
                <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap py-1 text-sm text-night-text">
                  {command}
                </code>
                <button
                  type="button"
                  class="shrink-0 rounded-md px-2.5 py-1.5 text-xs font-semibold text-night-muted transition hover:bg-white/10 hover:text-night-text"
                  data-copy={command}
                  data-copy-label={t.install.copy}
                  data-copied-label={t.install.copied}
                >
                  {t.install.copy}
                </button>
              </div>
            ))
          }
        </div>

        <a
          class="mt-8 inline-flex h-11 items-center rounded-[var(--radius-token)] bg-white px-6 font-semibold text-night transition hover:bg-white/90"
          href={DOCS_URL}
          rel="noopener"
        >
          {t.install.cta}
        </a>
      </div>

      <div class="min-w-0 rounded-[var(--radius-token-lg)] border border-white/12 bg-white/5 p-7">
        <h3 class="text-sm font-semibold uppercase tracking-widest text-night-faint">
          {t.install.requirementsTitle}
        </h3>
        <ul class="mt-4 grid gap-3">
          {
            t.install.requirements.map((requirement) => (
              <li class="flex gap-2.5 text-night-muted">
                <svg class="mt-1 size-4 shrink-0 text-violet-bright" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="m3.5 8.5 3 3 6-7"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{requirement}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

